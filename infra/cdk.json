{
  "app": "uv run --project .. python app.py",
  "watch": {
    "include": ["**"],
    "exclude": ["cdk.out", "tests", "**/__pycache__"]
  },
  "context": {
    "project": "card-advisor",
    "region": "us-east-2",
    "github_repo": "justinccu/card-advisor",
    "monthly_budget_usd": 50,
    "cors_origins": ["http://localhost:3000"],
    "@aws-cdk/core:defaultCrossStackReferences": "strong"
  }
}
