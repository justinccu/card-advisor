# Secrets (local environment files are never committed)
.env.local

# CDK Build Artifacts
cdk/cdk.out/
cdk/node_modules/

# CLI Internals
.cli/*

# Ephemeral Staging
.cache/*

# Exception: Commit the State
!.cli/deployed-state.json

# Build output of `agentcore package` / `deploy` (a zip per runtime and its staging folder)
*.zip
*/staging/
